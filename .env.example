HF_TOKEN=hf_your_token_here
# Optional: more tokens (comma-separated, e.g. from another HF account), used
# in order when the one before them is expired, out of credits or rate-limited.
# HF_FALLBACK_TOKENS=hf_second_token,hf_third_token

# Chat model + pinned provider. This is BILLED against your HF account's
# credits, not free -- despite the name, no provider on the router serves
# any model for free (verified against the live router listing). Must be a
# model+provider combination where the provider supports tool calling
# (phi-4 does not; check https://router.huggingface.co/v1/models before
# switching). Optional; these are the defaults if unset.
LLM_MODEL=Qwen/Qwen2.5-72B-Instruct
LLM_PROVIDER=deepinfra

# Optional: other providers with a free tier, used in this order when every HF
# token above has failed (or Hugging Face itself is down). Set a key to switch
# one on; several keys can be comma-separated. Each <NAME>_MODEL is optional
# and must be a model that supports tool calling.
# GROQ_API_KEY=            # https://console.groq.com/keys
# GROQ_MODEL=llama-3.3-70b-versatile
# GEMINI_API_KEY=          # https://aistudio.google.com/apikey
# GEMINI_MODEL=gemini-3.5-flash-lite
# CEREBRAS_API_KEY=        # https://cloud.cerebras.ai
# CEREBRAS_MODEL=llama-3.3-70b
# OPENROUTER_API_KEY=      # https://openrouter.ai/keys
# OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free

# Signs login tokens. Required, at least 32 characters, keep it secret.
# Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# Changing it logs everyone out. Optional: JWT_EXPIRE_MINUTES (access token
# lifetime, default 15) and REFRESH_TOKEN_DAYS (refresh token lifetime, default 7).
JWT_SECRET=replace-me-with-a-long-random-string

# Only needed if running the API / seed_data.py directly on your host
# (outside Docker). When using `docker compose`, DATABASE_URL is set
# automatically in docker-compose.yml to point at the "db" service.
DATABASE_URL=postgresql://supportbot:supportbot@localhost:5432/supportbot

# Production only (see render.yaml):
# TRUST_PROXY=true   -- behind one reverse proxy (Render): rate limits use the
#                       client IP the proxy appends to X-Forwarded-For
# ENABLE_DOCS=false  -- hide /docs, /redoc and /openapi.json
